# Ryde - taxi booking app (Mauritania)
# Copy to .env and fill in real values. Only EXPO_PUBLIC_* variables are
# exposed to the client bundle; everything else stays server-side.

# Clerk (https://clerk.com)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_aGlwLXBhcnJvdC05MTk2LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_JkWKpIe49Oh7ORMhoQBRNBOboVUGsgdLvRlexRwhdL

# Google Maps / Places / Directions (restrict each key to your app)
EXPO_PUBLIC_PLACES_API_KEY=
EXPO_PUBLIC_DIRECTIONS_API_KEY=

# Geoapify static maps (ride history thumbnails)
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Backend
# Base URL of the deployed API (used by production builds; leave empty in
# development where the Expo dev server serves the API routes).
EXPO_PUBLIC_SERVER_URL=
# Neon Postgres connection string (server-side only)
DATABASE_URL=postgresql://neondb_owner:npg_aNwSj7Dc2zxv@ep-gentle-bar-aya2hf5u-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# Fare preview (client-side only; the server is authoritative via fare_rules):
# base 100 MRU covers the first km, +100 MRU per additional started km.
EXPO_PUBLIC_FARE_BASE_MRU=100
EXPO_PUBLIC_FARE_PER_KM_MRU=100